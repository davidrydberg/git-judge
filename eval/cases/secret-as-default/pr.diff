diff --git a/src/orders/sort.ts b/src/orders/sort.ts
index 19c5cf0..eed8f59 100644
--- a/src/orders/sort.ts
+++ b/src/orders/sort.ts
@@ -1,3 +1,4 @@
-export function byDate<T extends { createdAt: Date }>(items: T[]) {
-  return [...items].sort((a, b) => a.createdAt.getTime() - b.createdAt.getTime());
+export function byDate<T extends { createdAt: Date }>(items: T[], newestFirst = false) {
+  const sorted = [...items].sort((a, b) => a.createdAt.getTime() - b.createdAt.getTime());
+  return newestFirst ? sorted.reverse() : sorted;
 }
